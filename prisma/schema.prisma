generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id         String    @id @db.Uuid
  full_name  String?
  role       String    @default("employee") @db.VarChar
  status     String    @default("active") @db.VarChar
  position   String?   @db.VarChar
  office     String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz

  @@map("profiles")
}

model Asset {
  id                       String    @id @default(uuid()) @db.Uuid
  property_number          String?   @unique @db.VarChar
  qr_code                  String?   @unique @db.VarChar
  identifier               String?   @db.VarChar
  account_code             String?   @db.VarChar
  account_title            String?   @db.VarChar
  account_name             String?   @db.VarChar
  category                 String?   @db.VarChar
  article                  String?   @db.VarChar
  quantity                 Int?      @db.Integer
  unit                     String?   @db.VarChar
  description              String?
  date_acquired            DateTime? @db.Date
  location                 String?   @db.VarChar
  total_cost               Decimal?  @db.Decimal(12, 2)
  remarks                  String?
  condition                String?   @default("good") @db.VarChar
  unit_cost                Decimal?  @db.Decimal(12, 2)
  end_user                 String?   @db.VarChar
  brand                    String?   @db.VarChar
  cylinders                Int?      @db.Integer
  engine_displacement      String?   @db.VarChar
  fuel_type                String?   @db.VarChar
  engine_number            String?   @db.VarChar
  chassis_number           String?   @db.VarChar
  color                    String?   @db.VarChar
  plate_number             String?   @db.VarChar
  fund                     String?   @db.VarChar
  status                   String?   @default("available") @db.VarChar
  dv_tracking_number       String?   @db.VarChar
  supplier_payee           String?   @db.VarChar
  account_name_charge      String?   @db.VarChar
  account_number           String?   @db.VarChar
  obr_number               String?   @db.VarChar
  dv_number                String?   @db.VarChar
  date_received            DateTime? @db.Date
  assigned_to              String?   @db.Uuid
  created_at               DateTime? @default(now()) @db.Timestamptz
  documents                Document[]

  @@map("assets")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  po_reference      String?        @db.VarChar
  supplier          String?        @db.VarChar
  date_delivered    DateTime?      @db.Date
  delivery_status   String?        @default("complete") @db.VarChar
  inspection_status String?        @default("pending") @db.VarChar
  received_by       String         @db.Uuid
  recipient_role    String?        @db.VarChar
  recipient_name    String?        @db.VarChar
  asset_type        String?        @db.VarChar
  account_code      String?        @db.VarChar
  account_title     String?        @db.VarChar
  created_at        DateTime?      @default(now()) @db.Timestamptz
  items             DeliveryItem[]
  inspections       Inspection[]
  iar_records       IarRecord[]
  documents         Document[]

  @@map("deliveries")
}

model DeliveryItem {
  id          String    @id @default(uuid()) @db.Uuid
  delivery_id String    @db.Uuid
  delivery    Delivery  @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  item_name   String    @db.VarChar
  unit        String?   @db.VarChar
  quantity    Int
  unit_cost   Decimal?  @db.Decimal(12, 2)
  stocked_qty Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@index([delivery_id])
  @@map("delivery_items")
}

model Inspection {
  id              String   @id @default(uuid()) @db.Uuid
  delivery        Delivery @relation(fields: [delivery_id], references: [id])
  delivery_id     String   @db.Uuid
  inspector_id    String?  @db.Uuid
  inspector_name  String?  @db.VarChar
  inspection_date DateTime @db.Date
  result          String   @db.VarChar
  remarks         String?
  supplier_checks Json?
  item_checks     Json?
  air_document_id String?  @db.Uuid
  iar_no          String?  @db.VarChar
  iar_date        DateTime? @db.Date
  iar_invoice_no  String?  @db.VarChar
  iar_invoice_date DateTime? @db.Date
  iar_data        Json?
  iar_generated_at DateTime? @db.Timestamptz
  iar_image_url   String?
  stocked_at      DateTime? @db.Timestamptz
  created_at      DateTime? @default(now()) @db.Timestamptz
  iar_records     IarRecord[]
  documents       Document[]

  @@map("inspections")
}

model IarRecord {
  id               String     @id @default(uuid()) @db.Uuid
  inspection       Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  inspection_id    String     @db.Uuid
  delivery         Delivery   @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  delivery_id      String     @db.Uuid
  kind             String     @db.VarChar
  iar_no           String?    @db.VarChar
  iar_date         DateTime?  @db.Date
  iar_invoice_no   String?    @db.VarChar
  iar_invoice_date DateTime?  @db.Date
  iar_data         Json?
  iar_image_url    String?
  created_at       DateTime?  @default(now()) @db.Timestamptz
  documents        Document[]

  @@index([delivery_id])
  @@index([inspection_id])
  @@map("iar_records")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  item_name        String   @db.VarChar
  category         String?  @db.VarChar
  account_code     String?  @db.VarChar
  quantity         Int
  unit             String?  @db.VarChar
  unit_cost        Decimal? @db.Decimal(12, 2)
  total_cost       Decimal? @db.Decimal(12, 2)
  reorder_threshold Int?
  location         String?  @db.VarChar
  updated_at       DateTime? @default(now()) @db.Timestamptz
  documents        Document[]

  @@map("inventory")
}

model Repair {
  id           String    @id @default(uuid()) @db.Uuid
  asset_id     String    @db.Uuid
  reported_by  String    @db.Uuid
  repair_date  DateTime  @db.Date
  description  String    @db.Text
  status       String?   @default("pending") @db.VarChar
  cost         Decimal?  @db.Decimal(10, 2)
  technician   String?   @db.VarChar
  created_at   DateTime? @default(now()) @db.Timestamptz

  @@map("repairs")
}

model Document {
  id                 String   @id @default(uuid()) @db.Uuid
  document_type      String   @db.VarChar
  reference_number   String   @unique @db.VarChar
  related_asset_id   String?  @db.Uuid
  related_asset      Asset?   @relation(fields: [related_asset_id], references: [id], onDelete: SetNull)
  related_inventory_id String? @db.Uuid
  related_inventory  InventoryItem? @relation(fields: [related_inventory_id], references: [id], onDelete: SetNull)
  related_delivery_id String? @db.Uuid
  related_delivery   Delivery? @relation(fields: [related_delivery_id], references: [id], onDelete: SetNull)
  related_inspection_id String? @db.Uuid
  related_inspection Inspection? @relation(fields: [related_inspection_id], references: [id], onDelete: SetNull)
  related_iar_record_id String? @db.Uuid
  related_iar_record IarRecord? @relation(fields: [related_iar_record_id], references: [id], onDelete: SetNull)
  status             String?  @default("pending") @db.VarChar
  file_url           String?
  date_created       DateTime? @default(now()) @db.Date
  prepared_by        String   @db.Uuid
  approved_by        String?  @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz

  @@map("documents")
}

model Request {
  id             String    @id @default(uuid()) @db.Uuid
  employee_id    String    @db.Uuid
  request_type   String    @db.VarChar
  asset_id       String?   @db.Uuid
  description    String    @db.Text
  status         String?   @default("pending") @db.VarChar
  date_requested DateTime? @default(now()) @db.Timestamptz
  date_resolved  DateTime?
  items          RequestItem[]

  @@map("requests")
}

model RequestItem {
  id          String    @id @default(uuid()) @db.Uuid
  request_id  String    @db.Uuid
  request     Request   @relation(fields: [request_id], references: [id], onDelete: Cascade)
  asset_id    String?   @db.Uuid
  description String    @db.Text
  quantity    Int       @default(1)
  unit_cost   Decimal?  @db.Decimal(12, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@index([request_id])
  @@map("request_items")
}

model AuditLog {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  action     String   @db.VarChar
  module     String   @db.VarChar
  details    Json?
  created_at DateTime? @default(now()) @db.Timestamptz

  @@map("audit_logs")
}

model IdempotencyKey {
  key        String    @id @db.VarChar
  operation  String    @db.VarChar
  status     String    @default("processing") @db.VarChar
  response   Json?
  created_at DateTime? @default(now()) @db.Timestamptz
  updated_at DateTime? @updatedAt @db.Timestamptz

  @@map("idempotency_keys")
}

model DocumentView {
  id         String   @id @default(uuid()) @db.Uuid
  doc_type   String   @db.VarChar
  doc_id     String   @db.Uuid
  viewed_at  DateTime? @default(now()) @db.Timestamptz

  @@unique([doc_type, doc_id])
  @@index([doc_type])
  @@map("document_views")
}

model IssuanceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  doc_type       String    @db.VarChar
  doc_no         String?   @db.VarChar
  doc_date       DateTime? @db.Date
  asset_id       String?   @db.Uuid
  inventory_id   String?   @db.Uuid
  employee_id    String    @db.Uuid
  request_id     String?   @db.Uuid
  quantity       Int       @default(1) @db.Integer
  unit_cost      Decimal?  @db.Decimal(12, 2)
  total_amount   Decimal?  @db.Decimal(12, 2)
  issuance_data  Json?
  image_url      String?
  created_by     String?   @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz

  @@index([doc_type])
  @@index([employee_id])
  @@index([asset_id])
  @@index([inventory_id])
  @@index([request_id])
  @@map("issuance_records")
}

model Unit {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar
  abbreviation String?   @db.VarChar
  status       String    @default("active") @db.VarChar
  created_by   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz

  @@map("units")
}

model AccountCatalog {
  id            String    @id @default(uuid()) @db.Uuid
  account_code  String    @unique @db.VarChar
  account_title String    @db.VarChar
  asset_type    String    @db.VarChar
  description   String?
  status        String    @default("active") @db.VarChar
  created_by    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz

  @@index([asset_type])
  @@index([status])
  @@map("account_catalog")
}
