generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id         String    @id @db.Uuid
  full_name  String?
  role       String    @default("employee") @db.VarChar
  status     String    @default("active") @db.VarChar
  position   String?   @db.VarChar
  office     String?   @db.VarChar
  created_at DateTime? @default(now()) @db.Timestamptz

  // Employee profile completion (first login after approval).
  prefix               String?   @db.VarChar(20)
  first_name           String?   @db.VarChar(100)
  middle_name          String?   @db.VarChar(100)
  last_name            String?   @db.VarChar(100)
  suffix               String?   @db.VarChar(20)
  employee_no          String?   @unique @db.VarChar(50)
  department           String?   @db.VarChar(255)
  profile_completed    Boolean   @default(false)
  profile_completed_at DateTime? @db.Timestamptz

  @@index([role])
  @@index([status])
  @@index([role, status])
  @@map("profiles")
}

model Asset {
  id                       String    @id @default(uuid()) @db.Uuid
  property_number          String?   @unique @db.VarChar
  qr_code                  String?   @unique @db.VarChar
  identifier               String?   @db.VarChar
  account_code             String?   @db.VarChar
  account_title            String?   @db.VarChar
  account_name             String?   @db.VarChar
  category                 String?   @db.VarChar
  article                  String?   @db.VarChar
  quantity                 Int?      @db.Integer
  unit                     String?   @db.VarChar
  description              String?
  date_acquired            DateTime? @db.Date
  location                 String?   @db.VarChar
  total_cost               Decimal?  @db.Decimal(12, 2)
  remarks                  String?
  condition                String?   @default("good") @db.VarChar
  unit_cost                Decimal?  @db.Decimal(12, 2)
  end_user                 String?   @db.VarChar
  brand                    String?   @db.VarChar
  cylinders                Int?      @db.Integer
  engine_displacement      String?   @db.VarChar
  fuel_type                String?   @db.VarChar
  engine_number            String?   @db.VarChar
  chassis_number           String?   @db.VarChar
  color                    String?   @db.VarChar
  plate_number             String?   @db.VarChar
  fund                     String?   @db.VarChar
  status                   String?   @default("available") @db.VarChar
  dv_tracking_number       String?   @db.VarChar
  supplier_payee           String?   @db.VarChar
  account_name_charge      String?   @db.VarChar
  account_number           String?   @db.VarChar
  obr_number               String?   @db.VarChar
  dv_number                String?   @db.VarChar
  date_received            DateTime? @db.Date
  assigned_to              String?   @db.Uuid
  created_at               DateTime? @default(now()) @db.Timestamptz
  documents                Document[]
  custom_fields            Json?     @db.JsonB

  @@index([status])
  @@index([category])
  @@index([account_code])
  @@index([assigned_to])
  @@index([created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@index([account_code, status])
  @@map("assets")
}

model Delivery {
  id                String         @id @default(uuid()) @db.Uuid
  po_reference      String?        @db.VarChar
  supplier          String?        @db.VarChar
  date_delivered    DateTime?      @db.Date
  expected_arrival_date DateTime?  @db.Date
  delivery_kind     String?        @db.VarChar
  delivery_status   String?        @default("complete") @db.VarChar
  inspection_status String?        @default("pending") @db.VarChar
  received_by       String         @db.Uuid
  recipient_role    String?        @db.VarChar
  recipient_name    String?        @db.VarChar
  asset_type        String?        @db.VarChar
  account_code      String?        @db.VarChar
  account_title     String?        @db.VarChar
  created_at        DateTime?      @default(now()) @db.Timestamptz
  items             DeliveryItem[]
  inspections       Inspection[]
  iar_records       IarRecord[]
  documents         Document[]

  @@index([received_by])
  @@index([supplier])
  @@index([po_reference])
  @@index([delivery_status])
  @@index([inspection_status])
  @@index([created_at(sort: Desc)])
  @@index([received_by, created_at(sort: Desc)])
  @@map("deliveries")
}

model DeliveryItem {
  id          String    @id @default(uuid()) @db.Uuid
  delivery_id String    @db.Uuid
  delivery    Delivery  @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  item_name   String    @db.VarChar
  unit        String?   @db.VarChar
  quantity    Int
  unit_cost   Decimal?  @db.Decimal(12, 2)
  stocked_qty Int       @default(0)
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@index([delivery_id])
  @@map("delivery_items")
}

model Inspection {
  id              String   @id @default(uuid()) @db.Uuid
  delivery        Delivery @relation(fields: [delivery_id], references: [id])
  delivery_id     String   @db.Uuid
  inspector_id    String?  @db.Uuid
  inspector_name  String?  @db.VarChar
  inspection_date DateTime @db.Date
  result          String   @db.VarChar
  remarks         String?
  supplier_checks Json?
  item_checks     Json?
  air_document_id String?  @db.Uuid
  iar_no          String?  @db.VarChar
  iar_date        DateTime? @db.Date
  iar_invoice_no  String?  @db.VarChar
  iar_invoice_date DateTime? @db.Date
  iar_data        Json?
  iar_generated_at DateTime? @db.Timestamptz
  iar_image_url   String?
  stocked_at      DateTime? @db.Timestamptz
  created_at      DateTime? @default(now()) @db.Timestamptz
  iar_records     IarRecord[]
  documents       Document[]

  @@index([delivery_id])
  @@index([inspector_id])
  @@index([result])
  @@index([inspection_date(sort: Desc)])
  @@index([created_at(sort: Desc)])
  @@map("inspections")
}

model IarRecord {
  id               String     @id @default(uuid()) @db.Uuid
  inspection       Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  inspection_id    String     @db.Uuid
  delivery         Delivery   @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  delivery_id      String     @db.Uuid
  kind             String     @db.VarChar
  iar_no           String?    @db.VarChar
  iar_date         DateTime?  @db.Date
  iar_invoice_no   String?    @db.VarChar
  iar_invoice_date DateTime?  @db.Date
  iar_data         Json?
  iar_image_url    String?
  created_at       DateTime?  @default(now()) @db.Timestamptz
  documents        Document[]

  @@index([delivery_id])
  @@index([inspection_id])
  @@index([kind])
  @@index([iar_no])
  @@index([created_at(sort: Desc)])
  @@map("iar_records")
}

model InventoryItem {
  id               String   @id @default(uuid()) @db.Uuid
  item_name        String   @db.VarChar
  category         String?  @db.VarChar
  account_code     String?  @db.VarChar
  delivery_kind    String?  @db.VarChar
  quantity         Int
  unit             String?  @db.VarChar
  unit_cost        Decimal? @db.Decimal(12, 2)
  total_cost       Decimal? @db.Decimal(12, 2)
  reorder_threshold Int?
  location         String?  @db.VarChar
  updated_at       DateTime? @default(now()) @db.Timestamptz
  documents        Document[]
  custom_fields    Json?     @db.JsonB

  @@index([item_name])
  @@index([account_code])
  @@index([category])
  @@index([delivery_kind])
  @@index([quantity])
  @@map("inventory")
}

model AssetCustomField {
  id         String    @id @default(uuid()) @db.Uuid
  field_key  String    @unique @db.VarChar(60)
  label      String    @db.VarChar(80)
  field_type String    @default("text") @db.VarChar(10)
  created_by String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz

  @@map("asset_custom_fields")
}

model Repair {
  id           String    @id @default(uuid()) @db.Uuid
  asset_id     String    @db.Uuid
  reported_by  String    @db.Uuid
  repair_date  DateTime  @db.Date
  description  String    @db.Text
  status       String?   @default("pending") @db.VarChar
  cost         Decimal?  @db.Decimal(10, 2)
  technician   String?   @db.VarChar
  created_by   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz

  @@index([asset_id])
  @@index([status])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@map("repairs")
}

model Document {
  id                 String   @id @default(uuid()) @db.Uuid
  document_type      String   @db.VarChar
  reference_number   String   @unique @db.VarChar
  related_asset_id   String?  @db.Uuid
  related_asset      Asset?   @relation(fields: [related_asset_id], references: [id], onDelete: SetNull)
  related_inventory_id String? @db.Uuid
  related_inventory  InventoryItem? @relation(fields: [related_inventory_id], references: [id], onDelete: SetNull)
  related_delivery_id String? @db.Uuid
  related_delivery   Delivery? @relation(fields: [related_delivery_id], references: [id], onDelete: SetNull)
  related_inspection_id String? @db.Uuid
  related_inspection Inspection? @relation(fields: [related_inspection_id], references: [id], onDelete: SetNull)
  related_iar_record_id String? @db.Uuid
  related_iar_record IarRecord? @relation(fields: [related_iar_record_id], references: [id], onDelete: SetNull)
  status             String?  @default("pending") @db.VarChar
  file_url           String?
  date_created       DateTime? @default(now()) @db.Date
  prepared_by        String   @db.Uuid
  approved_by        String?  @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz

  @@index([related_asset_id])
  @@index([related_inventory_id])
  @@index([related_delivery_id])
  @@index([related_inspection_id])
  @@index([related_iar_record_id])
  @@index([status])
  @@index([document_type])
  @@index([prepared_by])
  @@index([created_at(sort: Desc)])
  @@map("documents")
}

model Request {
  id             String    @id @default(uuid()) @db.Uuid
  employee_id    String    @db.Uuid
  recipient_id   String?   @db.Uuid
  request_type   String    @db.VarChar
  asset_id       String?   @db.Uuid
  description    String    @db.Text
  status         String?   @default("pending") @db.VarChar
  date_requested DateTime? @default(now()) @db.Timestamptz
  date_resolved  DateTime?
  items          RequestItem[]

  @@index([recipient_id])
  @@index([employee_id])
  @@index([status])
  @@index([request_type])
  @@index([date_requested(sort: Desc)])
  @@index([status, date_requested(sort: Desc)])
  @@index([recipient_id, status])
  @@map("requests")
}

model RequestItem {
  id          String    @id @default(uuid()) @db.Uuid
  request_id  String    @db.Uuid
  request     Request   @relation(fields: [request_id], references: [id], onDelete: Cascade)
  asset_id    String?   @db.Uuid
  description String    @db.Text
  quantity    Int       @default(1)
  unit_cost   Decimal?  @db.Decimal(12, 2)
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@index([request_id])
  @@map("request_items")
}

model AuditLog {
  id         String   @id @db.Uuid
  user_id    String   @db.Uuid
  action     String   @db.VarChar
  module     String   @db.VarChar
  details    Json?
  created_at DateTime? @default(now()) @db.Timestamptz

  @@index([user_id])
  @@index([module])
  @@index([action])
  @@index([created_at(sort: Desc)])
  @@index([action, created_at(sort: Desc)])
  @@map("audit_logs")
}

model IdempotencyKey {
  key        String    @id @db.VarChar
  operation  String    @db.VarChar
  status     String    @default("processing") @db.VarChar
  response   Json?
  created_at DateTime? @default(now()) @db.Timestamptz
  updated_at DateTime? @updatedAt @db.Timestamptz

  @@map("idempotency_keys")
}

model DocumentView {
  id         String   @id @default(uuid()) @db.Uuid
  doc_type   String   @db.VarChar
  doc_id     String   @db.Uuid
  viewer_id  String?  @db.Uuid
  viewed_at  DateTime? @default(now()) @db.Timestamptz

  @@unique([doc_type, doc_id])
  @@unique([doc_type, doc_id, viewer_id])
  @@index([doc_type])
  @@map("document_views")
}

model IssuanceRecord {
  id             String    @id @default(uuid()) @db.Uuid
  doc_type       String    @db.VarChar
  doc_no         String?   @db.VarChar
  doc_date       DateTime? @db.Date
  asset_id       String?   @db.Uuid
  inventory_id   String?   @db.Uuid
  employee_id    String    @db.Uuid
  request_id     String?   @db.Uuid
  quantity       Int       @default(1) @db.Integer
  unit_cost      Decimal?  @db.Decimal(12, 2)
  total_amount   Decimal?  @db.Decimal(12, 2)
  issuance_data  Json?
  image_url      String?
  created_by     String?   @db.Uuid
  created_at     DateTime? @default(now()) @db.Timestamptz

  @@index([doc_type])
  @@index([employee_id])
  @@index([asset_id])
  @@index([inventory_id])
  @@index([request_id])
  @@index([created_by])
  @@index([created_at(sort: Desc)])
  @@index([doc_type, created_at(sort: Desc)])
  @@map("issuance_records")
}

model Unit {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique @db.VarChar
  abbreviation String?   @db.VarChar
  status       String    @default("active") @db.VarChar
  created_by   String?   @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz

  @@map("units")
}

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar
  description String?
  status      String    @default("active") @db.VarChar
  created_by  String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz

  @@map("departments")
}

model AccountCatalog {
  id            String    @id @default(uuid()) @db.Uuid
  account_code  String    @unique @db.VarChar
  account_title String    @db.VarChar
  account_name  String?   @db.VarChar
  asset_type    String    @db.VarChar
  description   String?
  status        String    @default("active") @db.VarChar
  created_by    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz

  @@index([asset_type])
  @@index([status])
  @@map("account_catalog")
}

model PpmpFile {
  id                 String    @id @default(uuid()) @db.Uuid
  filename           String    @db.VarChar
  storage_path       String    @db.Text
  file_size          Int?
  mime_type          String?   @db.VarChar
  created_by         String    @db.Uuid
  created_at         DateTime? @default(now()) @db.Timestamptz
  // P1 vault fix: content hash (dedup + cache key + audit), fiscal-year
  // hint, parse summary, lifecycle status. All nullable/defaulted so
  // legacy rows (metadata-only, no backing bytes) stay valid.
  file_hash          String?   @db.Text
  fiscal_year        Int?
  fiscal_year_source String?   @db.VarChar(20)
  row_count          Int?
  sheet_meta         Json?     @db.JsonB
  status             String?   @default("ready") @db.VarChar(20)
  updated_at         DateTime? @updatedAt @db.Timestamptz

  @@index([created_by])
  @@index([file_hash])
  @@map("ppmp_files")
}

model PpmpAnalyticsConfig {
  version              Int       @id
  qty_increase_pct     Float     @default(25)
  cost_increase_pct    Float     @default(30)
  anomaly_z            Float     @default(2.0)
  trend_epsilon_pct    Float     @default(5)
  forecast_min_history Int       @default(3)
  smoothing_alpha      Float     @default(0.5)
  updated_by           String?   @db.Uuid
  updated_at           DateTime? @default(now()) @db.Timestamptz

  @@map("ppmp_analytics_config")
}

model PpmpAnalysisSession {
  id             String    @id @default(uuid()) @db.Uuid
  user_id        String    @db.Uuid
  preset         String?   @db.VarChar(40)
  filters        Json?     @db.JsonB
  file_ids       Json      @db.JsonB
  file_hashes    Json      @db.JsonB
  parser_version String    @default("v1") @db.VarChar(20)
  config_version Int?
  stage          String    @default("queued") @db.VarChar(40)
  status         String    @default("running") @db.VarChar(20)
  error_code     String?   @db.VarChar(60)
  created_at     DateTime? @default(now()) @db.Timestamptz
  completed_at   DateTime? @db.Timestamptz

  @@index([user_id, created_at(sort: Desc)])
  @@map("ppmp_analysis_sessions")
}

model PpmpAnalysisResult {
  session_id      String    @id @db.Uuid
  overview        Json      @db.JsonB
  quarterly       Json?     @db.JsonB
  file_insights   Json?     @db.JsonB
  yoy             Json      @db.JsonB
  trends          Json      @db.JsonB
  anomalies       Json      @db.JsonB
  costs           Json      @db.JsonB
  forecasts       Json      @db.JsonB
  recommendations Json      @db.JsonB
  limitations     Json      @db.JsonB
  config          Json      @db.JsonB
  created_at      DateTime? @default(now()) @db.Timestamptz

  @@map("ppmp_analysis_results")
}
